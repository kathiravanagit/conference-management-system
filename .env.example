# College Conference Management System
# Root Directory Environment Variables

# ======================
# BACKEND CONFIGURATION
# ======================

# Backend Server Port
BACKEND_PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/your_collection_name

# JWT Secret Key (Change this in production!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Environmental Mode
NODE_ENV=development

# ======================
# FRONTEND CONFIGURATION
# ======================

# API Base URL
REACT_APP_API_URL=http://localhost:5000/api

# Socket.io Server URL
REACT_APP_SOCKET_URL=http://localhost:5000

# Frontend Port
PORT=3000

# ======================
# MONGODB CONFIGURATION
# ======================

# MongoDB Atlas Connection (if using cloud)
# MONGO_URI=your_url
# ======================
# PRODUCTION SETTINGS
# ======================

# After deployment, update these:
# FRONTEND_URL=https://yourdomain.vercel.app
# REACT_APP_API_URL=https://your-backend.herokuapp.com/api
# REACT_APP_SOCKET_URL=https://your-backend.herokuapp.com
# CORS_ORIGIN=https://yourdomain.vercel.app

# ======================
# OPTIONAL CONFIGURATIONS
# ======================

# Email Service (Optional - for production email)
# SENDGRID_API_KEY=your_sendgrid_api_key
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# Third-party Integrations
# JITSI_DOMAIN=meet.jitsi.org
# ZOHO_MEETING_API_KEY=your_api_key

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=your_ga_id

# ======================
# SECURITY NOTES
# ======================
# 1. Never commit .env file to version control
# 2. Use strong, unique JWT_SECRET in production
# 3. Use app passwords for Gmail - not your main password
# 4. Rotate secrets regularly
# 5. Use environment-specific configs for prod/dev/test
# 6. Keep sensitive data in .env files, not in code
